{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wasm:build",
      "type": "shell",
      "command": "${workspaceFolder}/wasm/build.bat",
      "options": { "cwd": "${workspaceFolder}/wasm" },
      "windows": {
        "command": "${workspaceFolder}/wasm/build.bat"
      },
      "linux": {
        "command": "bash",
        "args": ["build.sh"]
      },
      "osx": {
        "command": "bash",
        "args": ["build.sh"]
      }
    },
    {
      "label": "wasm:copy-to-frontend",
      "type": "shell",
      "command": "copy",
      "args": ["freeform.js", "..\\front\\public\\freeform.js", "&&", "copy", "freeform.wasm", "..\\front\\public\\freeform.wasm"],
      "options": { "cwd": "${workspaceFolder}/wasm" },
      "windows": {
        "command": "cmd",
        "args": ["/c", "copy freeform.js ..\\front\\public\\freeform.js && copy freeform.wasm ..\\front\\public\\freeform.wasm"]
      },
      "linux": {
        "command": "cp",
        "args": ["freeform.js", "freeform.wasm", "../front/public/"]
      },
      "osx": {
        "command": "cp",
        "args": ["freeform.js", "freeform.wasm", "../front/public/"]
      }
    },
    {
      "label": "wasm:build-and-copy",
      "dependsOrder": "sequence",
      "dependsOn": ["wasm:build", "wasm:copy-to-frontend"]
    },
    {
      "label": "frontend:dev",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/front" }
    },
    {
      "label": "frontend:build",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/front" }
    },
    {
      "label": "dev (frontend only - WASM)",
      "dependsOn": ["frontend:dev"]
    },
    {
      "label": "build:all (WASM + frontend)",
      "dependsOrder": "sequence",
      "dependsOn": ["wasm:build-and-copy", "frontend:build"]
    }
  ]
}
