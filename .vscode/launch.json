{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Frontend (WASM mode)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Build WASM + Run Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "preLaunchTask": "wasm:build-and-copy",
      "console": "integratedTerminal"
    }
  ]
}
